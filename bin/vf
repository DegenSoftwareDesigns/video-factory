#!/usr/bin/env bash
# video-factory production commands (scripts/videos.py) from any project folder.
# The open folder becomes the client project unless --project or VIDEO_FACTORY_PROJECT says otherwise.
set -euo pipefail
. "$(dirname "${BASH_SOURCE[0]}")/_vf-env.sh"
exec "$VF_PYTHON" "$VF_ROOT/scripts/videos.py" "$@"
