# Configure only providers you use, in your own local .env or shell environment.
# Scripts do not automatically load this root file. Export variables into the
# shell that launches the agent, or use each provider's supported auth mechanism.
# HeyGen: prefer `heygen auth login --oauth` rather than sharing account tokens.
# video-use expects its own .claude/skills/video-use/.env (see GUIDE.md).
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
