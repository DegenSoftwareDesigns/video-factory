# Provider keys, configured only for providers you use. Copy this file to .env in
# the project the work is for (a client project's root, or this workshop for
# standalone work), so each project's spending is billed to its own keys.
# Nothing loads it by itself: run keyed tools through bin/vf-run (vf-run.cmd),
# and check with `vf-run --list`, which prints key names only.
# HeyGen: prefer `heygen auth login --oauth` rather than sharing account tokens.
# Keep .claude/skills/video-use/.env without keys: video-use reads it first.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
